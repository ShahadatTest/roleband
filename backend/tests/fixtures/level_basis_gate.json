      "passes": ["swe_senior", "swe_unstated", "em_unstated", "em_unmapped", "em_principal"]
    },
    {
      "name": "answers: unstated stays out when not included",
      "bands": ["mid", "senior"], "include_unstated_level": false,
      "answers": [{"track": "technical", "roles": "any"}, {"track": "management", "roles": "any"}],
      "passes": ["swe_senior", "swe_mid", "swe_mid_legacy"]
    },
    {
