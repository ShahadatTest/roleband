    },
    {
      "name": "senior+ with unstated",
      "bands": ["senior", "principal"], "include_unstated_level": true, "answers": null,
      "passes": ["swe_senior", "swe_unstated", "em_unstated", "em_unmapped", "em_principal"]
    },
    {
      "name": "mid without unstated: a placeholder mid is not mid",
      "bands": ["mid"], "include_unstated_level": false, "answers": null,
      "passes": ["swe_mid", "swe_mid_legacy"]
    },
    {
      "name": "mid with unstated",
      "bands": ["mid"], "include_unstated_level": true, "answers": null,
      "passes": ["swe_unstated", "em_unstated", "em_unmapped", "swe_mid", "swe_mid_legacy"]
    },
    {
      "name": "answers: unstated skips the management range when included",
      "bands": ["senior", "principal"], "include_unstated_level": true,
