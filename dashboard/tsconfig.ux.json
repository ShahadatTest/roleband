/* Typechecking for `tests/ux/`, which `tsconfig.json` does not reach.
 *
 * The main config includes only `src`, so `tsc -b` never looks at a Playwright
 * spec; without this file the UX suite, where nearly every user-visible claim
 * lives, would be the one part of the tree with no static checking at all.
 *
 * The two `noUnused*` flags are ON here: for tests they are exactly the signal
 * that a split or a rename left something behind (a dead import after a spec
 * split), which is the failure mode this directory actually has.
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    /* The specs run in Node and in a modern browser, not in the app's build
       target, so `Array.prototype.at` and friends are genuinely available here
       even though `tsconfig.json` caps `lib` at ES2021 for shipped code. */
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  },
  "include": ["tests", "src/test", "playwright.config.ts"]
}
